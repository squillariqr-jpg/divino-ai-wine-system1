# Template only - copy to /opt/rete-squillari-mcp-prod/shared/rete-mcp.env
# on the target host, fill in real values, and set permissions to
# 600 rete-mcp:rete-mcp (readable only by the service user and root).
#
# This file is never committed with real values. Nothing below is a real
# credential.

# Connection string for the DEDICATED rete_mcp_reader Postgres role only -
# never the Supabase service_role key, never the postgres superuser.
# Generate the role's password out-of-band (e.g. `openssl rand -base64 32`)
# and set it via:
#   ALTER ROLE rete_mcp_reader WITH LOGIN PASSWORD '<generated>';
# run once, directly, by an operator with database admin access - never
# committed to any migration or repository file.
# sslmode=verify-full is required (not just sslmode=require) - it
# validates the server's certificate chain and hostname, not just that
# the connection is encrypted. MCPConfig.validate() refuses to start
# without it for any non-loopback host.
RETE_MCP_DATABASE_URL=postgresql://rete_mcp_reader:REPLACE_ME@db.ljuyolwnlbqlfxjujfrq.supabase.co:5432/postgres?sslmode=verify-full

# Generate with: openssl rand -base64 48
RETE_MCP_JWT_SECRET=REPLACE_ME_MINIMUM_32_CHARS

RETE_MCP_JWT_ISSUER=rete-squillari-mcp-prod
RETE_MCP_JWT_AUDIENCE=rete-squillari-mcp-prod

# Path to a JSON file the operator maintains for token revocation, e.g.
# {"revoked_jti": ["<jti-1>", "<jti-2>"]}. The server reloads this file
# periodically (see auth.py TokenVerifier._reload_revoked) without a
# restart. Must be owned by rete-mcp:rete-mcp, mode 600.
RETE_MCP_REVOKED_JTI_PATH=/opt/rete-squillari-mcp-prod/shared/revoked_jti.json

RETE_MCP_BIND_HOST=127.0.0.1
RETE_MCP_BIND_PORT=8791

RETE_MCP_ENV=production
RETE_MCP_LOG_LEVEL=INFO
